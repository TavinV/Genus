{
  "name": "@genus/collector-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env.dev src/server.ts",
    "start": "tsx src/server.ts",
    "dev:enroll-fake": "tsx --env-file-if-exists=.env.dev scripts/enroll-fake.ts",
    "postman:test": "tsx scripts/postman-test.ts",
    "bench:punch": "tsx scripts/bench-punch.ts",
    "dev:punch": "tsx --env-file-if-exists=.env.dev scripts/dev-punch.ts",
    "fraud:frames": "tsx --env-file-if-exists=.env.dev scripts/fraud-frames.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.9",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@genus/db-arp": "workspace:*",
    "@genus/queue": "workspace:*",
    "@genus/shared": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
